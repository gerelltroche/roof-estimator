{
  "name": "@roof-estimator/widget",
  "version": "0.1.0",
  "description": "<roof-quote>: an embeddable instant roof quote widget (web component + React) for contractor websites. Works in Astro, plain HTML, React, Vue, Svelte.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/roof-quote.js",
  "module": "./dist/roof-quote.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/roof-quote.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/roof-quote.js"
  ],
  "keywords": [
    "roofing",
    "estimate",
    "quote",
    "web-component",
    "astro",
    "lead-generation"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"no widget tests yet\""
  },
  "dependencies": {
    "@roof-estimator/core": "workspace:*",
    "@roof-estimator/geo": "workspace:*",
    "maplibre-gl": "^4.7.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
