{
  "name": "roof-estimator",
  "private": true,
  "version": "0.1.0",
  "description": "Open source roof measurement, material takeoff, and estimating",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --filter @roof-estimator/core build && pnpm -r test",
    "typecheck": "pnpm --filter @roof-estimator/core build && pnpm -r typecheck",
    "dev": "pnpm --filter @roof-estimator/web dev",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
